# Local prototype config — Project SPK running against a local Ollama server
# on your own laptop instead of the OpenAI API. See LOCAL_PROTOTYPE.md.
#
# This is NOT the production deployment. Production keeps running on Railway
# with OPENAI_API_KEY exactly as it does today — nothing about that changes.
# This file only affects an app instance you run on your own machine.
#
# Prereq: scripts/setup_local_prototype.sh has been run once (installs
# Ollama, pulls a model sized to your laptop's RAM, installs Python deps).

# Point the existing OpenAI client at the local Ollama server instead of
# api.openai.com. Ollama ignores the key value — any non-empty string works.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

# Model tags must match what setup_local_prototype.sh pulled via `ollama pull`.
# The setup script writes the right values here automatically based on your
# laptop's RAM (and GPU, if it detects an NVIDIA card) — the defaults below
# are just a starting point if you're editing this by hand.
OPENAI_MODEL=qwen2.5:7b-instruct
OPENAI_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=openai

# Optional shared-key auth for scripts/automation (bypasses the roster).
APP_API_KEY=

# --- Access roster (email sign-in) ---
# This is your personal prototype — there's no team to gate out. Leave this
# set to your own email, or set it to empty to disable login entirely.
ACCESS_ROSTER=
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_HOURS=24

# Local usage log — stays on this laptop's disk only.
USAGE_DB_PATH=
USAGE_ADMIN_EMAILS=

HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=300

MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
MAX_RETRIEVAL_CANDIDATES=40

# Kept modest for a CPU-bound (or laptop-GPU-bound) local model — a large
# context budget here means long waits before the first token. Raise this
# once you move to the RTX 5090/PRO 6000 box; it's independent of
# production's MAX_CONTEXT_CHARS on Railway.
MAX_CONTEXT_CHARS=40000
MAX_CHUNKS_PER_SOURCE=8

# Separate index/data dirs from your day-to-day checkout so a prototype
# ingest run never gets mixed up with anything else on disk.
CHROMA_PERSIST_DIR=./chroma_db_local
DATA_DIR=./data_local
