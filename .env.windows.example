# Project SPK on a Windows laptop, offline, with Ollama instead of the OpenAI API.
# scripts/setup_windows.ps1 copies this to .env and fills in the model names.
# See WINDOWS.md.
#
# Prepare this laptop while you still have a network. In the field it does
# not call OpenAI, Railway, or any other host.

# Ollama ignores the key, but the app refuses to start a request without one.
OPENAI_API_KEY=ollama
# The OpenAI client talks to Ollama on this laptop. Leave Ollama on localhost.
# Do not set OLLAMA_HOST=0.0.0.0.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Filled in by the setup script from this laptop's RAM and GPU.
OPENAI_MODEL=qwen2.5:7b-instruct
# Scanned-page OCR. A text chat model cannot read a drawing.
OPENAI_VISION_MODEL=qwen2.5vl:3b
OPENAI_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=openai
# Ollama embeds one small batch at a time. 128 (the OpenAI default) stalls it.
EMBEDDING_BATCH_SIZE=8

# Optional shared key for the upload scripts. Leave blank to sign in through
# the browser. Sign-in is a local roster check; it does not send email.
APP_API_KEY=

# Leave unset to use the roster built into app/config.py (the two of you).
# The setup script fills AUTH_SECRET so a restart does not sign you out.
AUTH_SECRET=
AUTH_TOKEN_HOURS=24

USAGE_DB_PATH=
USAGE_ADMIN_EMAILS=william.a.pratt@usace.army.mil

# This laptop is the only client. 127.0.0.1 means nothing else on a shared
# or austere network can open the app. The Mac mini uses 0.0.0.0 so a second
# person on the home network can connect; do not copy that here.
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=300

MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
MAX_RETRIEVAL_CANDIDATES=40
MAX_CONTEXT_CHARS=40000
MAX_CHUNKS_PER_SOURCE=8

# Its own index. A copy of the Mac's chroma_db_mac folder can be placed here
# after the Mac has rebuilt it with nomic-embed-text. The Railway index cannot.
CHROMA_PERSIST_DIR=./chroma_db_laptop
DATA_DIR=./data

# Chroma must not post telemetry off this machine.
ANONYMIZED_TELEMETRY=False
