# Project SPK on a Mac mini, with Ollama instead of the OpenAI API.
# scripts/setup_mac_mini.sh copies this to .env and fills in the model names.
# See MAC_MINI.md.

# Ollama ignores the key, but the app refuses to start a request without one.
OPENAI_API_KEY=ollama
# The OpenAI client talks to Ollama's compatible endpoint. Ollama itself stays
# on localhost — do not set OLLAMA_HOST=0.0.0.0, or the model is reachable by
# anyone on the network with no sign-in.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# Filled in by the setup script from the Mac's memory.
OPENAI_MODEL=qwen2.5:7b-instruct
# Scanned-page OCR. A text chat model cannot read a drawing.
OPENAI_VISION_MODEL=qwen2.5vl:3b
OPENAI_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=openai
# Ollama embeds one small batch at a time. 128 (the OpenAI default) stalls it.
EMBEDDING_BATCH_SIZE=8

# Optional shared key for the upload scripts on this Mac. Leave blank to sign
# in through the browser instead.
APP_API_KEY=

# Leave unset to use the roster built into app/config.py (the two of you).
# The setup script fills AUTH_SECRET so sessions survive a restart.
AUTH_SECRET=
AUTH_TOKEN_HOURS=24

USAGE_DB_PATH=
USAGE_ADMIN_EMAILS=william.a.pratt@usace.army.mil

# 0.0.0.0 lets the other roster user open the app from their own machine on
# the same network. Ollama is still localhost-only.
HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=300

MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
MAX_RETRIEVAL_CANDIDATES=40
# A laptop-class model answers slowly once the prompt gets huge. Raise this
# on a Mac mini with 32 GB or more.
MAX_CONTEXT_CHARS=40000
MAX_CHUNKS_PER_SOURCE=8

# A new index. The Railway Chroma database was embedded with OpenAI and
# cannot be queried by nomic-embed-text.
CHROMA_PERSIST_DIR=./chroma_db_mac
DATA_DIR=./data
