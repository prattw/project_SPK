# Optional locally; set when hosting online (team access — UI will prompt)
APP_API_KEY=

# Required — answers (Claude)
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Required — embeddings (pairs well with Claude)
# Sign up: https://www.voyageai.com/
VOYAGE_API_KEY=pa-your-key-here
EMBEDDING_PROVIDER=voyage
VOYAGE_EMBEDDING_MODEL=voyage-3

# Alternative: OpenAI embeddings only (keep Claude for answers)
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-key-here

HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=300

# Large PDFs (2000+ page specs)
MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
PDF_PROGRESS_EVERY_PAGES=25
PDF_EMBED_FLUSH_CHUNKS=250

# Per-question context (Claude never sees the full PDF at once)
MAX_RETRIEVAL_CANDIDATES=40
MAX_CONTEXT_CHARS=120000
MAX_CHUNKS_PER_SOURCE=8

CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data
