# OpenAI — one key for GPT answers + embeddings
# Create at https://platform.openai.com/api-keys
# (ChatGPT Plus subscription is separate from API billing.)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# Optional locally; required when hosting (team access — UI will prompt)
APP_API_KEY=

HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=300

MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
MAX_RETRIEVAL_CANDIDATES=40
MAX_CONTEXT_CHARS=120000
MAX_CHUNKS_PER_SOURCE=8

CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data
