# OpenAI — one key for GPT answers + embeddings
# Create at https://platform.openai.com/api-keys
# (ChatGPT Plus subscription is separate from API billing.)
OPENAI_API_KEY=sk-your-key-here
# Optional: override the API root for Azure OpenAI, a proxy, or a local gateway.
# Leave blank to use the default https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# Optional simple shared-key auth (leave blank if using WebAuthn below)
APP_API_KEY=

# --- WebAuthn / YubiKey access control ---
# Leave these BLANK for local dev (the app stays open). Set them on the hosted
# deployment (e.g. Railway) to require a registered security key to use the app.
#   - RP_ID is your domain, no scheme/port (e.g. projectspk-production.up.railway.app)
#   - ORIGIN is the full https URL (e.g. https://projectspk-production.up.railway.app)
#   - ENROLL_CODE is a secret you share only with authorized users so they can
#     register their key once (admin allowlist). Change it to rotate enrollment.
#   - SESSION_SECRET signs login cookies; set a long random string and keep it stable.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=
WEBAUTHN_ENROLL_CODE=
SESSION_SECRET=
SESSION_MAX_AGE_HOURS=12
# Put this on a persistent volume in production so enrolled keys survive deploys.
AUTH_DB_PATH=./auth.db

HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=300

MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
MAX_RETRIEVAL_CANDIDATES=40
MAX_CONTEXT_CHARS=120000
MAX_CHUNKS_PER_SOURCE=8

CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data
