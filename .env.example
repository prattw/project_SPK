# OpenAI — one key for GPT answers + embeddings
# Create at https://platform.openai.com/api-keys
# (ChatGPT Plus subscription is separate from API billing.)
OPENAI_API_KEY=sk-your-key-here
# Optional: override the API root for Azure OpenAI, a proxy, or a local gateway.
# Leave blank to use the default https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=openai

# Optional shared-key auth for scripts/automation (bypasses the roster).
# Also grants admin access to /usage/* and /admin/library/* for GitHub Actions
# weekly reports — use this durable value as the SPK_TOKEN repo secret.
APP_API_KEY=

# --- Access roster (email sign-in) ---
# Only these emails can sign in. Comma-separated. The default roster is built
# into app/config.py; set this to override it without a code change.
# Leave the variable unset to use the built-in roster.
#ACCESS_ROSTER=first.m.last@usace.army.mil,other.m.person@usace.army.mil
# Signing secret for login tokens. Set a long random string in production
# (e.g. `openssl rand -hex 32`) so sessions survive restarts/redeploys.
AUTH_SECRET=
# Users must sign in again after this many hours.
AUTH_TOKEN_HOURS=24
# SQLite usage log (logins, queries, uploads, tokens, latency).
# Default when unset: {DATA_DIR}/usage.db (stays on the Railway volume).
# Production: leave blank OR set USAGE_DB_PATH=/data/files/usage.db
USAGE_DB_PATH=
# Comma-separated emails allowed to view GET /usage/summary and /usage/weekly
USAGE_ADMIN_EMAILS=william.a.pratt@usace.army.mil

HOST=0.0.0.0
PORT=8000
MAX_UPLOAD_MB=300

MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
MAX_RETRIEVAL_CANDIDATES=40
MAX_CONTEXT_CHARS=120000
MAX_CHUNKS_PER_SOURCE=8

CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data
