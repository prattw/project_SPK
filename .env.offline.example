# Offline/austere deployment config — Project SPK running against a local
# Ollama server instead of the OpenAI API. See DEPLOY_OFFLINE.md.
#
# Prereq: scripts/setup_offline_macbook.sh has been run (installs Ollama,
# pulls the models below, installs Python deps) WHILE STILL ON A NETWORK.

# Point the existing OpenAI client at the local Ollama server instead of
# api.openai.com. Ollama's API key is not checked — any non-empty value works.
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=ollama

# Model tags must match what was pulled via `ollama pull ...`.
# 8 GB RAM laptop:  llama3.2:3b   /  16 GB RAM laptop: qwen2.5:7b
OPENAI_MODEL=llama3.2:3b
OPENAI_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai

# Optional shared-key auth for scripts/automation (bypasses the roster)
APP_API_KEY=

# --- Access roster (email sign-in) ---
# For a single-user offline kit, leaving this unset uses the built-in
# roster. Set to empty/a single email, or disable login entirely if this
# laptop is a personal single-user kit — see README for the no-auth option.
#ACCESS_ROSTER=first.m.last@usace.army.mil
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_HOURS=24

# Local usage log — stays on this laptop's disk, never uploaded anywhere.
USAGE_DB_PATH=
USAGE_ADMIN_EMAILS=

HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=300

MAX_PDF_PAGES=2500
MAX_CHUNKS_PER_FILE=6000
PDF_BACKGROUND_PAGE_THRESHOLD=75
MAX_RETRIEVAL_CANDIDATES=40
MAX_CONTEXT_CHARS=120000
MAX_CHUNKS_PER_SOURCE=8

CHROMA_PERSIST_DIR=./chroma_db
DATA_DIR=./data
